# Example environment variables for production
# Copy to .env and fill in secure values (do NOT commit the real .env to version control)

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com  # comma-separated hosts
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database (use DATABASE_URL or individual vars)
# Example: mysql://dbuser:dbpass@dbhost:3306/dbname
DATABASE_URL=mysql://dbuser:dbpass@dbhost:3306/dbname
# Or set individually
DATABASE_NAME=dbname
DATABASE_USER=dbuser
DATABASE_PASSWORD=dbpass
DATABASE_HOST=dbhost
DATABASE_PORT=3306

# Optional: set to true to enable detailed security checks
DJANGO_CHECK_DEPLOY=True
